# Audio transcription service
S2T_API_URL=https://api.siliconflow.cn/v1/audio/transcriptions
S2T_API_KEY=
S2T_MODEL=FunAudioLLM/SenseVoiceSmall

# OpenAI-compatible text processing service
OPT_API_URL=https://api.openai.com/v1/chat/completions
OPT_API_KEY=
OPT_MODEL=
CALIBRATION_MODEL=
SUMMARY_MODEL=
NOTES_MODEL=

# Optional OpenAI-compatible wrapper authentication
API_ACCESS_TOKEN=

# Runtime limits and retry behaviour
PORT=5000
MAX_UPLOAD_MB=100
MAX_TEXT_CHARS=250000
API_TIMEOUT_SECONDS=300
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2
CHUNK_TARGET_SIZE=5000
CHUNK_PROCESSING_THRESHOLD=5500
MAX_CONCURRENT_WORKERS=3
